// console.log(ageDistribution);

use("BD2");
db.getCollection("documents").aggregate([
  // Unwind the hashtags array to deconstruct the array field
  { $unwind: "$hashtags" },
  // Group by each hashtag and count their occurrences
  { $group: { _id: "$hashtags", count: { $sum: 1 } } },
  // Sort by count in descending order to find the most popular hashtag
  { $sort: { count: -1 } },
  // Limit to the most popular hashtag
  { $limit: 1 },
  // Lookup documents containing the most popular hashtag
  {
    $lookup: {
      from: "documents",
      localField: "_id",
      foreignField: "hashtags",
      as: "documentsWithPopularHashtag",
    },
  },
  // Unwind the documentsWithPopularHashtag array to get individual documents
  { $unwind: "$documentsWithPopularHashtag" },
  // Replace root with the documents containing the most popular hashtag
  { $replaceRoot: { newRoot: "$documentsWithPopularHashtag" } },
  // Group by age to get the distribution of age
  { $group: { _id: "$age", count: { $sum: 1 } } },
  // Sort by age in ascending order
  { $sort: { _id: 1 } },
]);

