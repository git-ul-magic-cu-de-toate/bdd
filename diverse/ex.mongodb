// console.log(youngAuthors);

// db.documents.find({ age: { $lte: 35 } });

use("BD2");
db.getCollection("documents").aggregate([
  // Match documents with authors who are 35 years old or younger
  { $match: { age: { $lte: 35 } } },
  // Group by gender and count the number of documents for each gender
  { $group: { _id: "$gender", documentCount: { $sum: 1 } } },
  // Sort by gender in ascending order
  { $sort: { _id: 1 } },
]);
