// 1. Să se găsească documentele care conțin cel mai popular hashtag.
// 2. Să se găsească cel mai activ autor după numărul de documente create.
// 3. Pentru toate documentele care content cel mai popular hashtag vedeti distributia de varsta.

// Bonus:
// 1. Cate documente cu autori Tineri (<= 35 de ani) avem pentru fiecare gen?
// 2. Pentru documentele din laboratorul 11 care se afla in cercul de centru (20,20) si raza 100,
// care sunt top 3 cele mai folosite Tipuri de Enitati (campul namedEntities.type; la egalitate sortati alfabetic)?

// 1. Să se găsească documentele care conțin cel mai popular hashtag.

use("BD2");

const allHashtags = db.documents
  .aggregate([
    { $unwind: "$hashtags" },

    { $group: { _id: "$hashtags", count: { $sum: 1 } } },

    { $sort: { count: -1 } },
  ])
  .toArray();

console.log(allHashtags);

const mostPopularHashtag = db.documents
  .aggregate([
    { $unwind: "$hashtags" },

    { $group: { _id: "$hashtags", count: { $sum: 1 } } },

    { $sort: { count: -1 } },

    { $limit: 1 },
  ])
  .toArray();

console.log(mostPopularHashtag);

db.documents.find({ hashtags: mostPopularHashtag[0]._id });

